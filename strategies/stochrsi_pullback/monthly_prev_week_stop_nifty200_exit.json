{
  "name": "stochrsi_pullback/monthly_prev_week_stop_nifty200_exit",
  "description": "Monthly StochRSI pullback; stop at the previous week's low. No new entries while NIFTY 50 is below its 200-day average (Sensex before mid-2008). Open trades are sold at the next open when NIFTY 50 closes below its 200-day average.",
  "universe": "NIFTY500",
  "period": {
    "start": "2000-01-01"
  },
  "timeframe": "M",
  "setup": {
    "type": "stochrsi_cross",
    "rsi": 14,
    "stoch": 14,
    "k": 3,
    "d": 3,
    "oversold": 30
  },
  "filters": {
    "trend_ema": {
      "span": 61,
      "timeframes": [
        "M",
        "W",
        "D"
      ]
    },
    "rsi_min": {
      "period": 14,
      "value": 50
    }
  },
  "entry": {
    "valid_bars": 1,
    "day_filters": {
      "market_sma": 200
    }
  },
  "stop": {
    "type": "prev_week_low",
    "market_tighten": "exit",
    "market_sma": 200
  },
  "exits": {
    "targets_pct": [
      null,
      8,
      15,
      20,
      30
    ],
    "ema_close_when_no_target": {
      "span": 61
    },
    "max_days": null
  },
  "sizing": {
    "capital": 100000,
    "risk_pct": 1.0,
    "max_positions": 8,
    "rank": "tightest"
  },
  "costs": {
    "broker": "sharekhan",
    "product": "delivery",
    "slippage_pct": 0.1
  }
}
